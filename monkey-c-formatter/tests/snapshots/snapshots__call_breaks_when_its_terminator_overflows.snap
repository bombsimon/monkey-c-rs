function f() {
    if (true) {
        var monthformat = WatchUi.loadResource(
            Rez.Strings.Default_Format_Month
        );
        var day = monthString.substring(
            monthpos + 1,
            monthString.length()
        ).toNumber();
        var fits = WatchUi.loadResource(Rez.Strings.Month); // trailing comments are not measured
    }
