function f() {
    var min = timeString
        .substring(hourpos + 1, timeString.length())
        .toNumber();
    days = currentmoment
        .subtract(matchdatemoment)
        .value()
        .toLong()
        .format("%d");
    var fits = a.b().c().d();
}
