---
function f() {
    var shiftSum = (a + b) << c;
    var sumShift = a + b << c;
    var maskEquals = a & b == c;
    var maskOfEquals = a & (b == c);
    var orThenAdd = a | b + c;
    var addOr = a + (b | c);
    var equalsLess = a == b < c;
    var lessOfEquals = a == (b < c);
    var instanceAnd = a instanceof B & c;
    var sumInstance = (a + b) instanceof C;
}
