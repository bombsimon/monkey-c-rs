function f() {
    View.findDrawableById("LBL_MATCH_DAY").setText(
        Lang.format("$1$", [year])
    );
    return Toybox.ActivityMonitor
        .getHeartRateHistory(1, true)
        .next()
        .heartRate.toString();
    me.getItems(filter).first().name.toUpperCase();
}
